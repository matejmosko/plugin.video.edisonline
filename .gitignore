# Kodi Addon .gitignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Kodi specific
.kodirc
kodi.log
temp/
cache/
userdata/
.kodi/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
htmlcov/

# Token/credential storage (should never be committed)
.tokens
.credentials
auth.json

# Edisonline session / credentials (must never be committed)
session_cookies.json
*.har
session_cookie_json.txt
# Ignore userdata credential dumps but keep the addon's settings template
settings.xml
!resources/settings.xml

# ZIP files
*.zip

# OS specific
Thumbs.db
.DS_Store
._*
.Spotlight-V100
.Trashes
